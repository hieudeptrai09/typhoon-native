# Copy to .env.local. Expo loads it automatically; the scripts read it via --env-file.
#
# Only EXPO_PUBLIC_ variables reach the app bundle, so nothing below may be renamed with that
# prefix — it would ship the value to every device.

# Used by the API routes (app/api/v1/**). These are read on the server at request time, so a
# deployed build needs them on the host too (EAS Hosting: `eas env:set`), not just here.
SUPABASE_URL=https://[UR_PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Used by npm run facts only. Use the pooled connection string (port 6543, "Transaction" mode);
# be/direct.ts disables prepared statements to match it.
SUPABASE_POSTGRES_URL=postgresql://[UR_USER]:[UR_PW]@[UR_HOST]:6543/[UR_DB]

# Where the deployed API routes answer. Ignored by `expo start` — the dev server is always its own
# origin — and read by app.config.ts when exporting or building. eas.json sets it per build
# profile, so this only matters for a local `expo export` or `eas build --local`.
EXPO_PUBLIC_API_ORIGIN=https://typhoon-native--preview.expo.app
