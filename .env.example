# Copy to .env.local.

# Metro inlines EXPO_PUBLIC_* into the bundle, so never put a service-role key here. EAS builds do
# not read this file — set the same two with `eas env:create`.
EXPO_PUBLIC_SUPABASE_URL=https://[UR_PROJECT_REF].supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# npm run facts only. Pooled connection (port 6543, "Transaction" mode) to match the prepare:false
# setting in scripts/db.ts.
SUPABASE_POSTGRES_URL=postgresql://[UR_USER]:[UR_PW]@[UR_HOST]:6543/[UR_DB]
